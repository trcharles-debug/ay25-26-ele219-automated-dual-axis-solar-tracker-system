        for (i = 0; i < n1; i++) {
            u1i = ~u1[i];
            cb += u1i;
            y -= ldexp(cb, exp_0);
            cb = (uint32_T)(cb < u1i);
            exp_0 += 32;
        }
    } else {
        for (i = 0; i < n1; i++) {
            y += ldexp(u1[i], exp_0);
            exp_0 += 32;
        }
    }
    return y;
}
