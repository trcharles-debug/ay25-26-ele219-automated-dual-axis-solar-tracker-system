real_T sMultiWord2Double(const uint32_T u1[], int16_T n1, int16_T e1)
{
    real_T y;
    uint32_T cb;
    uint32_T u1i;
    int16_T exp_0;
    int16_T i;
    y = 0.0;
    exp_0 = e1;
    if ((u1[n1 - 1] & 2147483648UL) != 0UL) {
